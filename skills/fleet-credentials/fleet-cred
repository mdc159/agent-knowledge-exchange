#!/usr/bin/env python3
"""fleet-cred — request short-lived fleet credentials by capability.

Agents use this instead of ever handling .env files or static keys:

    fleet-cred capabilities                # what can this node request?
    fleet-cred openrouter                  # print a fresh (or cached) runtime key
    fleet-cred openrouter --ttl 3600 --limit-usd 2
    fleet-cred env openrouter              # export OPENROUTER_API_KEY=...
    fleet-cred github --repo mdc159/agent-knowledge-exchange
    fleet-cred env github --repo <owner/repo>   # export GH_TOKEN=...
    fleet-cred revoke openrouter           # forget locally

Auth is automatic: the broker identifies this machine by its Tailscale node
identity. No token, no config file, no secret on disk. Access is granted per
node in the broker's policy.json; if denied, ask the operator (or open an
issue in agent-knowledge-exchange) to grant the capability.

Brokers are tried in order (donna primary, kvm-4 failover). Override with
FLEET_BROKER_URLS="https://a,https://b" or FLEET_BROKER_URL for a single one.

Exit codes: 0 ok · 3 capability denied for this node · 4 all brokers
unreachable · 5 unexpected error.
"""
from __future__ import annotations

import argparse
import getpass
import json
import os
import socket
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

DEFAULT_BROKERS = [
    "https://donna.tailfedd3b.ts.net:8459",
    "https://kvm-4.tailfedd3b.ts.net:8459",
]
RENEW_MARGIN_SECONDS = 120

CAPABILITIES = {
    "openrouter": {
        "endpoint": "/v1/keys",
        "env_var": "OPENROUTER_API_KEY",
        "default_ttl": 14400,
        "default_limit": 5,
    },
    "github": {
        "endpoint": "/v1/github/token",
        "env_var": "GH_TOKEN",
    },
}


def brokers() -> list[str]:
    multi = os.environ.get("FLEET_BROKER_URLS")
    if multi:
        return [b.strip().rstrip("/") for b in multi.split(",") if b.strip()]
    single = os.environ.get("FLEET_BROKER_URL")
    if single:
        return [single.rstrip("/")]
    return DEFAULT_BROKERS


def _user_id() -> str:
    try:
        return str(os.getuid())
    except AttributeError:  # Windows
        return getpass.getuser()


def cache_dir() -> str:
    path = os.path.join(tempfile.gettempdir(), f"fleet-cred-{_user_id()}")
    os.makedirs(path, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:  # Windows: permissions handled by ACLs
        pass
    return path


def cache_path(name: str) -> str:
    safe = "".join(c if c.isalnum() or c in "-_" else "_" for c in name)
    return os.path.join(cache_dir(), f"{safe}.json")


def read_cache(name: str) -> dict | None:
    try:
        with open(cache_path(name), "r", encoding="utf-8") as fh:
            entry = json.load(fh)
        expires = datetime.fromisoformat(
            entry["expires_at"].replace("Z", "+00:00")
        ).timestamp()
        if time.time() < expires - RENEW_MARGIN_SECONDS and entry.get("key"):
            return entry
    except (OSError, ValueError, KeyError):
        pass
    return None


def write_cache(name: str, entry: dict) -> None:
    path = cache_path(name)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(entry, fh)


def clear_cache(name: str) -> None:
    try:
        os.unlink(cache_path(name))
    except OSError:
        pass


def request(method: str, endpoint: str, payload: dict | None = None) -> dict:
    """Try brokers in order. HTTP 4xx/5xx responses are terminal (not a
    failover case) except 502/503/504 which suggest a sick broker."""
    body = json.dumps(payload).encode() if payload is not None else None
    last_err: Exception | None = None
    for base in brokers():
        req = urllib.request.Request(
            base + endpoint, data=body, method=method,
            headers={"Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as exc:
            detail = ""
            try:
                detail = json.load(exc).get("detail", "")
            except Exception:
                pass
            if exc.code in (502, 503, 504):
                last_err = exc
                continue  # try next broker
            if exc.code == 403:
                print(
                    f"denied: this node ({socket.gethostname()}) has no grant — {detail}\n"
                    "ask the operator to add it to the broker policy "
                    "(/opt/fleet-secrets/broker/policy.json on donna)",
                    file=sys.stderr,
                )
                sys.exit(3)
            if exc.code == 401:
                print("denied: broker could not identify this tailnet node", file=sys.stderr)
                sys.exit(3)
            print(f"broker error {exc.code}: {detail}", file=sys.stderr)
            sys.exit(5)
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            last_err = exc
            continue
    print(f"all brokers unreachable ({', '.join(brokers())}): {last_err}", file=sys.stderr)
    sys.exit(4)


def mint_openrouter(ttl: int, limit: float, label: str) -> dict:
    result = request("POST", "/v1/keys", {
        "label": label, "ttl_seconds": ttl, "limit_usd": limit,
    })
    return {
        "key": result["key"],
        "expires_at": result["expires_at"],
        "hash": result["hash"],
        "limit_usd": result["limit_usd"],
    }


def mint_github(repos: list[str], permissions: dict[str, str]) -> dict:
    result = request("POST", "/v1/github/token", {
        "repositories": repos, "permissions": permissions,
    })
    return {
        "key": result["token"],
        "expires_at": result["expires_at"],
        "repositories": result["repositories"],
        "permissions": result["permissions"],
    }


def cmd_openrouter(args: argparse.Namespace) -> None:
    name = "openrouter"
    entry = None if args.no_cache else read_cache(name)
    if entry is None:
        entry = mint_openrouter(args.ttl, args.limit_usd, args.label)
        if not args.no_cache:
            write_cache(name, entry)
    emit(args, entry)


def cmd_github(args: argparse.Namespace) -> None:
    if not args.repo:
        print("github capability needs --repo <owner/name>", file=sys.stderr)
        sys.exit(2)
    permissions = {}
    for perm in args.permission or []:
        k, _, v = perm.partition(":")
        permissions[k.strip()] = v.strip() or "read"
    if not permissions:
        permissions = {"contents": "read"}
    name = "github_" + "_".join(sorted(args.repo))
    entry = None if args.no_cache else read_cache(name)
    if entry is None:
        entry = mint_github(args.repo, permissions)
        if not args.no_cache:
            write_cache(name, entry)
    emit(args, entry)


def emit(args: argparse.Namespace, entry: dict) -> None:
    if getattr(args, "json", False):
        safe = dict(entry)
        safe["key"] = "<present>" if entry.get("key") else None
        print(json.dumps({**safe, "key": entry["key"]} if args.show_key else safe))
    else:
        print(entry["key"])


def cmd_env(args: argparse.Namespace) -> None:
    args.json = False
    args.show_key = False
    args.no_cache = False
    if args.capability == "openrouter":
        entry = read_cache("openrouter") or mint_openrouter(14400, 5, "fleet-cred")
        write_cache("openrouter", entry)
        print(f"export OPENROUTER_API_KEY={entry['key']}")
    elif args.capability == "github":
        if not args.repo:
            print("github needs --repo", file=sys.stderr)
            sys.exit(2)
        name = "github_" + "_".join(sorted(args.repo))
        entry = read_cache(name) or mint_github(args.repo, {"contents": "read"})
        write_cache(name, entry)
        print(f"export GH_TOKEN={entry['key']}")


def cmd_revoke(args: argparse.Namespace) -> None:
    # Server-side revocation is an admin operation; from a node we forget the
    # cached credential. It self-revokes at expiry regardless.
    if args.capability == "openrouter":
        clear_cache("openrouter")
    else:
        for f in os.listdir(cache_dir()):
            if f.startswith("github_"):
                os.unlink(os.path.join(cache_dir(), f))
    print(f"forgotten locally: {args.capability} (auto-revokes at expiry)")


def cmd_capabilities(_args: argparse.Namespace) -> None:
    result = request("GET", "/v1/capabilities")
    print(f"caller: {result['caller']} ({result['kind']})")
    for cap in result["capabilities"]:
        if not cap.get("configured"):
            status = "NOT CONFIGURED yet"
        elif cap.get("max_ttl_seconds"):
            status = f"up to {cap['max_ttl_seconds']}s / ${cap['max_limit_usd']}"
        elif cap.get("repositories"):
            status = f"repos: {', '.join(cap['repositories'])}"
        else:
            status = "granted"
        print(f"  {cap['capability']}: {status}")


def main() -> None:
    parser = argparse.ArgumentParser(prog="fleet-cred", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    po = sub.add_parser("openrouter", help="get a short-lived OpenRouter key")
    po.add_argument("--ttl", type=int, default=14400)
    po.add_argument("--limit-usd", type=float, default=5)
    po.add_argument("--label", default=f"fleet-cred:{os.path.basename(os.getcwd())}")
    po.add_argument("--json", action="store_true")
    po.add_argument("--show-key", action="store_true", help="include key in --json output")
    po.add_argument("--no-cache", action="store_true")
    po.set_defaults(fn=cmd_openrouter)

    pg = sub.add_parser("github", help="get a repo-scoped GitHub token")
    pg.add_argument("--repo", action="append", help="owner/name (repeatable)")
    pg.add_argument("--permission", action="append", help="name:level, e.g. contents:write")
    pg.add_argument("--json", action="store_true")
    pg.add_argument("--show-key", action="store_true", help="include key in --json output")
    pg.add_argument("--no-cache", action="store_true")
    pg.set_defaults(fn=cmd_github)

    pe = sub.add_parser("env", help="print a shell export line")
    pe.add_argument("capability", choices=list(CAPABILITIES))
    pe.add_argument("--repo", action="append")
    pe.set_defaults(fn=cmd_env)

    pr = sub.add_parser("revoke", help="forget cached credentials locally")
    pr.add_argument("capability", choices=list(CAPABILITIES))
    pr.set_defaults(fn=cmd_revoke)

    pc = sub.add_parser("capabilities", help="list what this node may request")
    pc.set_defaults(fn=cmd_capabilities)

    args = parser.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
